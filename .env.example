# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Google AI Studio API key (primary LLM provider)
LLM_API_KEY=

# Groq API key (optional fallback provider)
GROQ_API_KEY=

# Optional: where the durable match queue is stored
LAST_PROCESSED_MATCH_FILE=last_processed_match.json

# Optional: port for the health endpoint (Render sets this automatically)
PORT=10000
